<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>com.watchmydog.launcher</string>
  <key>CFBundleName</key>
  <string>WatchMyDog</string>
  <key>CFBundleDisplayName</key>
  <string>WatchMyDog</string>
  <key>CFBundleExecutable</key>
  <string>watchmydog-launcher</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSMinimumSystemVersion</key>
  <string>13.0</string>
  <!-- Background helper: no Dock icon, no menu bar. -->
  <key>LSUIElement</key>
  <true/>
  <!-- Shown in the macOS permission prompts. -->
  <key>NSCameraUsageDescription</key>
  <string>WatchMyDog streams this camera to your phone so you can check on your dog while you are away.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>WatchMyDog streams the room's sound to your phone so you can hear whether your dog is howling.</string>
